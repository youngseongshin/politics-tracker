{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://politics-tracker.dev/schemas/stance.schema.json",
  "title": "Stance",
  "description": "발언 하나에서 추출한 정책 축 위의 입장. 공개 가능한 결과는 근거 인용구를 가진다.",
  "type": "object",
  "required": [
    "stance_id", "utterance_id", "person_id", "axis", "value", "confidence",
    "rationale_quote", "extractor", "human_reviewed", "held_reason"
  ],
  "properties": {
    "stance_id": { "type": "string", "pattern": "^stance_" },
    "utterance_id": { "type": "string" },
    "person_id": { "type": "string" },
    "axis": { "type": "string" },
    "value": { "type": "number", "minimum": -1, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale_quote": { "type": "string" },
    "extractor": {
      "type": "object",
      "required": ["backend", "model", "prompt_version"],
      "properties": {
        "backend": { "type": "string" },
        "model": { "type": "string" },
        "prompt_version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "human_reviewed": { "type": "boolean" },
    "held_reason": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
