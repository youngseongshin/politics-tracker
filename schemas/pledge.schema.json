{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://politics-tracker.dev/schemas/pledge.schema.json",
  "title": "Pledge",
  "description": "등록 시 판정 기준을 고정하고 근거와 상태 이력을 append-only로 보존하는 공약.",
  "type": "object",
  "required": [
    "pledge_id", "person_id", "text", "source", "criteria", "status_history"
  ],
  "properties": {
    "pledge_id": { "type": "string", "pattern": "^pledge_" },
    "person_id": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["kind", "url", "title"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "criteria": {
      "type": "string",
      "minLength": 1,
      "description": "공약 등록 이후 변경할 수 없는 이행 판정 기준."
    },
    "status_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["status", "decided_at", "evidence"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["이행", "부분 이행", "미이행", "검증 불가"]
          },
          "decided_at": { "type": "string", "format": "date" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["url", "note"],
              "properties": {
                "url": { "type": "string", "format": "uri" },
                "note": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
